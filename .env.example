# Copy to .env (git-ignored) at the repository root; user-service reads it at start-up.
# Real environment variables win over this file.

# log  = write one-time codes to the user-service log (default, development only)
# smtp = send them by email through the SMTP server below
NOTIFICATION_SENDER=log

# Gmail: smtp.gmail.com:587 with an app password (Google Account > Security > App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Shown as the sender; Gmail only accepts the account's own address.
SMTP_FROM=
