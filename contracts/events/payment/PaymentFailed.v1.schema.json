{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rhl:event:PaymentFailed:v1",
  "title": "PaymentFailed v1",
  "description": "The provider declined a charge attempt. The trip is never undone (FR-PAY); the amount stays owed and can be charged again. Topic payment.events.v1, key = tripId.",
  "type": "object",
  "allOf": [{ "$ref": "urn:rhl:event:envelope:v1" }],
  "properties": {
    "eventType": { "const": "PaymentFailed" },
    "eventVersion": { "const": 1 },
    "producer": { "const": "payment-service" },
    "payload": {
      "type": "object",
      "required": ["paymentId", "tripId", "customerId", "purpose", "amount", "currency", "attemptNo", "failureCode",
                   "failedAt"],
      "properties": {
        "paymentId": { "type": "string", "format": "uuid" },
        "tripId": { "type": "string", "format": "uuid" },
        "customerId": { "type": "string", "format": "uuid" },
        "purpose": { "enum": ["TRIP_FARE", "CANCELLATION_FEE"] },
        "amount": { "type": "integer", "minimum": 1 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "attemptNo": { "type": "integer", "minimum": 1 },
        "failureCode": { "type": "string", "minLength": 1, "maxLength": 50 },
        "failedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  }
}
