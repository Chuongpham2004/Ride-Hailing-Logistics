{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rhl:event:envelope:v1",
  "title": "Event envelope v1",
  "description": "Common envelope for every domain event published to Kafka (COM-009). Event schemas extend it via allOf and constrain eventType/payload.",
  "type": "object",
  "required": ["eventId", "eventType", "eventVersion", "occurredAt", "correlationId", "producer", "aggregateId", "aggregateVersion", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "type": "string", "pattern": "^[A-Z][A-Za-z]+$" },
    "eventVersion": { "type": "integer", "minimum": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "producer": { "type": "string", "pattern": "^[a-z][a-z-]+$" },
    "aggregateId": { "type": "string", "minLength": 1 },
    "aggregateVersion": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" }
  },
  "additionalProperties": false
}
