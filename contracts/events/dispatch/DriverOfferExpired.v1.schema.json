{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rhl:event:DriverOfferExpired:v1",
  "title": "DriverOfferExpired v1",
  "description": "The driver did not answer in time; the driver is AVAILABLE again. Topic dispatch.offers.v1, key = driverId.",
  "type": "object",
  "allOf": [{"$ref": "urn:rhl:event:envelope:v1"}],
  "properties": {
    "eventType": { "const": "DriverOfferExpired" },
    "eventVersion": { "const": 1 },
    "producer": { "const": "trip-service" },
    "payload": {
      "type": "object",
      "required": ["offerId", "tripId", "driverId", "expiredAt"],
      "properties": {
        "offerId": { "type": "string", "format": "uuid" },
        "tripId": { "type": "string", "format": "uuid" },
        "driverId": { "type": "string", "format": "uuid" },
        "expiredAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  }
}
