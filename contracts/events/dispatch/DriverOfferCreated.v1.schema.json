{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rhl:event:DriverOfferCreated:v1",
  "title": "DriverOfferCreated v1",
  "description": "A trip is offered to one driver until expiresAt; the driver is OFFERED meanwhile. Only the pickup is shared before acceptance (BR-013). Topic dispatch.offers.v1, key = driverId.",
  "type": "object",
  "allOf": [{"$ref": "urn:rhl:event:envelope:v1"}],
  "properties": {
    "eventType": { "const": "DriverOfferCreated" },
    "eventVersion": { "const": 1 },
    "producer": { "const": "trip-service" },
    "payload": {
      "type": "object",
      "required": [
        "offerId",
        "tripId",
        "driverId",
        "serviceType",
        "pickup",
        "estimatedPickupDistanceMeters",
        "createdAt",
        "expiresAt"
      ],
      "properties": {
        "offerId": { "type": "string", "format": "uuid" },
        "tripId": { "type": "string", "format": "uuid" },
        "driverId": { "type": "string", "format": "uuid" },
        "serviceType": { "enum": ["RIDE", "DELIVERY"] },
        "pickup": { "$ref": "#/$defs/stop" },
        "estimatedPickupDistanceMeters": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "stop": {
      "type": "object",
      "required": ["latitude", "longitude", "address"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "address": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "additionalProperties": true
    }
  }
}
