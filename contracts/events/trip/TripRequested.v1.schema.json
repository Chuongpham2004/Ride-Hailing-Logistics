{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rhl:event:TripRequested:v1",
  "title": "TripRequested v1",
  "description": "A customer created a trip from a quote and matching started. quoteId, quotedFare, currency and surgeMultiplier are the booked price (optional only for trips created before quotes were required). Topic trip.events.v1, key = tripId.",
  "type": "object",
  "allOf": [{"$ref": "urn:rhl:event:envelope:v1"}],
  "properties": {
    "eventType": { "const": "TripRequested" },
    "eventVersion": { "const": 1 },
    "producer": { "const": "trip-service" },
    "payload": {
      "type": "object",
      "required": ["tripId", "customerId", "serviceType", "status", "pickup", "dropoff", "matchingDeadline", "occurredAt"],
      "properties": {
        "tripId": { "type": "string", "format": "uuid" },
        "customerId": { "type": "string", "format": "uuid" },
        "serviceType": { "enum": ["RIDE", "DELIVERY"] },
        "status": { "const": "MATCHING" },
        "pickup": { "$ref": "#/$defs/stop" },
        "dropoff": { "$ref": "#/$defs/stop" },
        "matchingDeadline": { "type": "string", "format": "date-time" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "quoteId": { "type": "string", "format": "uuid" },
        "quotedFare": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "surgeMultiplier": { "type": "number", "minimum": 1 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "stop": {
      "type": "object",
      "required": ["latitude", "longitude", "address"],
      "properties": {
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "address": { "type": "string", "minLength": 1, "maxLength": 300 }
      },
      "additionalProperties": true
    }
  }
}
