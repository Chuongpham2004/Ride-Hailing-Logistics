{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rhl:ws:TRIP_DRIVER_LOCATION:v1",
  "title": "TRIP_DRIVER_LOCATION v1 (server -> client)",
  "description": "The assigned driver's validated position, sent only to the trip's customer while they follow the trip (BR-013). messageId is the DriverLocationUpdated eventId and aggregateVersion its sequence: a client drops a position older than the last one shown.",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:rhl:ws:message:v1"
    }
  ],
  "required": [
    "sequence",
    "aggregateVersion"
  ],
  "properties": {
    "type": {
      "const": "TRIP_DRIVER_LOCATION"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "tripId",
        "driverId",
        "sequence",
        "latitude",
        "longitude",
        "accuracyMeters",
        "serverTimestamp"
      ],
      "properties": {
        "tripId": {
          "type": "string",
          "format": "uuid"
        },
        "driverId": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracyMeters": {
          "type": "number",
          "minimum": 0
        },
        "headingDegrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "speedMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "serverTimestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
