{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rhl:ws:DRIVER_LOCATION_UPDATED:v1",
  "title": "DRIVER_LOCATION_UPDATED v1 (driver -> server)",
  "description": "A driver's position (README §8.4). The driver is the session's user, never a field of the message. Forwarded as DriverLocationReported to location.telemetry.raw.v1, where location-service validates it. sequence increases per report from the device.",
  "type": "object",
  "allOf": [
    {
      "$ref": "urn:rhl:ws:message:v1"
    }
  ],
  "required": [
    "sequence"
  ],
  "properties": {
    "type": {
      "const": "DRIVER_LOCATION_UPDATED"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "latitude",
        "longitude",
        "accuracyMeters",
        "deviceTimestamp"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "accuracyMeters": {
          "type": "number",
          "minimum": 0
        },
        "headingDegrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 360
        },
        "speedMetersPerSecond": {
          "type": "number",
          "minimum": 0
        },
        "deviceTimestamp": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
