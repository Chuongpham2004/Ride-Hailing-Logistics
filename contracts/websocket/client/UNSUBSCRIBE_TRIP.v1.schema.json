    }
  ],
  "properties": {
    "type": {
      "const": "UNSUBSCRIBE_TRIP"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "required": [
        "tripId"
      ],
      "properties": {
        "tripId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false
    }
  }
}
