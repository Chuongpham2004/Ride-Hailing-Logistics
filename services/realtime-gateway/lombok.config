# Lombok settings for realtime-gateway.
config.stopBubbling = true
# Marks generated code with @lombok.Generated so JaCoCo leaves it out of coverage.
lombok.addLombokGeneratedAnnotation = true
# Entities: only @Getter and a protected no-args constructor for JPA. State changes go through
# domain methods, and equals/hashCode/toString are left out on purpose (proxies, lazy loading, PII).
lombok.data.flagUsage = error
lombok.setter.flagUsage = error
lombok.equalsAndHashCode.flagUsage = error
lombok.toString.flagUsage = error
